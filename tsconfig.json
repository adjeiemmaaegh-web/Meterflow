{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "none",
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".build",
    "rootDir": "src",
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true
  },
  "files": ["src/types.ts", "src/engine.ts", "src/daily.ts", "src/storage.ts", "src/app.tsx"]
}
